{
  "name": "skymates-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "copy-nested": "cp -R skymates-app/public/* public/ && cp -R skymates-app/src/* src/",
    "json-server": "json-server --watch db.json --port 4000",
    "dev:all": "concurrently \"npm run dev\" \"npm run json-server\""
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.10",
    "@hookform/resolvers": "^4.1.3",
    "axios": "^1.8.4",
    "date-fns": "^4.1.0",
    "next": "14.1.0",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^2.1.4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0",
    "json-server": "^0.17.4",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
